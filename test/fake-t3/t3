#!/bin/sh
# A fake T3 Code CLI for the tests (test/fake-t3.ts puts this folder first on PATH). It logs every call and never
# touches the real T3 Code.
echo "t3 $*" >> "${FAKE_T3_LOG:-/dev/null}"
case "$1 $2" in
  "--version "*) echo "t3 v${FAKE_T3_VERSION:-0.1.4}" ;;
  "thread show") cat "${FAKE_T3_SHOW:-/dev/null}"; exit "${FAKE_T3_SHOW_CODE:-0}" ;;
  "thread start") echo '{"threadId":"mcp:new-planner"}' ;;
  "thread send") exit 0 ;;
  "thread --help") echo "start send show" ;;
  "project add") echo "added 00000000-0000-4000-8000-000000000001" ;;
  "service restart") [ -n "$FAKE_T3_UP" ] && : > "$FAKE_T3_UP"; exit 0 ;;
  *) exit 0 ;;
esac
