{
  "description": "E9G Factory: the guard, the builder and tester stop gate, live context and heartbeats. Inert outside an E9G team.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Monitor|Edit|Write|MultiEdit|NotebookEdit|Read|Grep|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "NODE_COMPILE_CACHE=\"${CLAUDE_PLUGIN_ROOT}/.cache\" E9G_NODE_CACHE=1 node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.ts\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "NODE_COMPILE_CACHE=\"${CLAUDE_PLUGIN_ROOT}/.cache\" E9G_NODE_CACHE=1 node \"${CLAUDE_PLUGIN_ROOT}/hooks/heartbeat.ts\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "NODE_COMPILE_CACHE=\"${CLAUDE_PLUGIN_ROOT}/.cache\" E9G_NODE_CACHE=1 node \"${CLAUDE_PLUGIN_ROOT}/hooks/stop.ts\"",
            "timeout": 1800
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "NODE_COMPILE_CACHE=\"${CLAUDE_PLUGIN_ROOT}/.cache\" E9G_NODE_CACHE=1 node \"${CLAUDE_PLUGIN_ROOT}/hooks/context.ts\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "NODE_COMPILE_CACHE=\"${CLAUDE_PLUGIN_ROOT}/.cache\" E9G_NODE_CACHE=1 node \"${CLAUDE_PLUGIN_ROOT}/hooks/context.ts\""
          }
        ]
      }
    ]
  }
}
